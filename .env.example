# ============ Database: MongoDB Atlas ============
# Atlas -> Database -> Connect -> Drivers -> copy the "mongodb+srv://" string.
# * Replace <password> with your database user's password; URL-encode special characters
#   (@ -> %40, # -> %23, / -> %2F, : -> %3A).
# * Atlas -> Network Access: add your server's IP (or 0.0.0.0/0 while testing; tighten for production).
MONGODB_URI=mongodb+srv://<db-user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=shikshak-setu
# Database name (used when the URI does not contain one). Defaults to "shikshak-setu".
MONGODB_DB=shikshak-setu

# ============ NextAuth ============
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# ============ OAuth (optional; buttons activate when both values are set) ============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ============ Payments: Razorpay ============
# Dashboard -> Account & Settings -> API Keys. Start with TEST keys (rzp_test_...).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> add {NEXTAUTH_URL}/api/webhooks/razorpay with events
# payment.captured, order.paid, payment.failed and a secret of your choice; paste the same secret here.
RAZORPAY_WEBHOOK_SECRET=

# ============ LEGAL GATE: fees charged to teachers ============
# Teacher fees: Rs 399 registration + 40% placement fee. "true" turns them on (owner decision, 2026-11-09).
# Have a UP lawyer review the legal documents (legal-docs/ folder) before relying on them.
# Rebuild (npm run build) after changing: public pages bake this in.
CANDIDATE_FEES_ENABLED=false

# ============ Email (verification + password reset) ============
# Any SMTP provider: Brevo, Amazon SES, Zoho, Resend SMTP, Gmail app password...
# Leave empty in development: emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VBF Teachers & Talent Solution <no-reply@yourdomain.in>"

# ============ Staff (admin area at /admin) ============
# Comma-separated emails. The person must sign up with that address AND confirm it.
ADMIN_EMAILS=

# ============ Security tuning (optional) ============
# How often (seconds) an existing login is re-checked so that a password reset logs out other devices. Default 60.
SESSION_RECHECK_SECONDS=60
# Extra disposable-email domains to block, comma separated (on top of the built-in list).
BLOCKED_EMAIL_DOMAINS=
# Set to false only for offline development: skips the "does this email domain have a mail server" DNS check.
EMAIL_DNS_CHECK=true

# ============ Public site settings ============
# WhatsApp number with country code, digits only (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# IMPORTANT for SEO: your real https domain (canonical links, sitemap and share images use this).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
